{
  "mcpServers": {
    "scarlett": {
      "type": "http",
      "url": "https://api.scarlett.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${SCARLETT_API_TOKEN}"
      }
    },
    "rea": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "rea-agents@6.8.0", "mcp"]
    }
  }
}
