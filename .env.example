# Kopiere diese Datei zu ".env" und trage deine echten Werte ein.
# Die .env wird NICHT ins Git committet (siehe .gitignore).

# Interner Integrations-Token deiner Notion-Integration (beginnt mit "ntn_" oder "secret_").
# Erstellen unter: https://www.notion.so/my-integrations  -> New integration
# Danach die Datenbank "Abend-Tasks" fuer die Integration freigeben
# (in Notion: DB oeffnen -> ... -> Connections -> Integration hinzufuegen).
NOTION_TOKEN=

# ID der Abend-Tasks-Datenbank.
NOTION_DB_ID=77d8a1796e0140cc8e4505021007d15f

# --- Phase 2: Google-Kalender (optional) ---
# Geheime iCal-Adresse deines Google-Kalenders (nur lesen).
# In Google Kalender: Einstellungen -> deinen Kalender waehlen ->
# "Geheime Adresse im iCal-Format" kopieren (endet auf .../basic.ics).
# Bleibt leer -> die App zeigt einfach einen "Kalender verbinden"-Hinweis.
GOOGLE_ICAL_URL=

# Wie viele Tage im Voraus geladen werden (Standard 14).
# CAL_DAYS=14
