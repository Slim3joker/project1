# Kopieren nach .env und ausfüllen.
#
# Für den normalen Betrieb (Abruf aus Garmin Connect) ist NICHTS davon nötig —
# die Anmeldung passiert einmalig interaktiv über poller/login.py.

# Abruf-Rhythmus
POLL_INTERVAL_MIN=180
POLL_DAYS=2

# Nur falls zusätzlich der offizielle Health-API-Webhook genutzt wird:
WEBHOOK_SECRET=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
