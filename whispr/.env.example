# --- Grundlagen -------------------------------------------------------------
PORT=8098

# Arbeitsverzeichnis (Job-Liste + Uploads während der Verarbeitung)
DATA_DIR=/data

# HIER LANDEN DIE FERTIGEN MARKDOWN-DATEIEN.
# Auf Unraid: den Share-Pfad des Containers, z. B. /transkripte,
# und in der Container-Konfiguration auf /mnt/user/Notizen/Transkripte mappen.
OUTPUT_DIR=/transkripte

# Optional: Original-Audio nach der Transkription hierhin verschieben.
# Leer lassen = Audio wird nach erfolgreicher Transkription gelöscht.
AUDIO_ARCHIVE_DIR=

# --- Transkription ----------------------------------------------------------
# local  = eigener Whisper-Container (onerahmet/openai-whisper-asr-webservice)
# openai = OpenAI-kompatible API (braucht OPENAI_API_KEY)
TRANSCRIBE_BACKEND=local

WHISPER_URL=http://whisper:9000
WHISPER_LANG=de          # oder "auto" für automatische Erkennung

# Nur für TRANSCRIBE_BACKEND=openai:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=whisper-1
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Verhalten --------------------------------------------------------------
CONCURRENCY=1            # gleichzeitige Transkriptionen (GPU: bei 1 lassen)
MAX_UPLOAD_MB=500
JOB_TIMEOUT_MIN=120
TIMESTAMPS=true          # Abschnitt "Mit Zeitmarken" ins Markdown schreiben

# --- Zugriffsschutz ---------------------------------------------------------
# Leer = offen (nur fürs LAN in Ordnung).
# Sobald die App über einen Tunnel/Reverse-Proxy von außen erreichbar ist: setzen!
AUTH_TOKEN=
