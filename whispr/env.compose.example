# Einstellungen für docker-compose.
#
# Diese Datei nach `.env` kopieren und anpassen:
#
#     cp env.compose.example .env
#     nano .env
#
# `.env` ist in .gitignore – ein `git pull` überschreibt sie also nie. Deshalb
# gehören eigene Pfade hierhin und nicht in die docker-compose.yml.

# Zielordner für die fertigen Markdown-Dateien (Host-Pfad).
# Auf Unraid der Share, den du per SMB öffnest:
TRANSKRIPTE_DIR=/mnt/user/Notizen/Transkripte

# Whisper-Modell. Auf CPU: tiny < base < small < medium.
# `medium` ist für Deutsch deutlich besser als `small`, braucht aber mehr RAM.
# `large-v3` nur mit GPU – auf CPU wird der Container beim Laden abgeschossen.
ASR_MODEL=small

# Port, unter dem die Oberfläche erreichbar ist.
WHISPR_PORT=8098
